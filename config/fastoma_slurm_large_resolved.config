manifest.contributors = [[name:'Sina Majidian', affiliation:'Johns Hopkins University; University of Lausanne', github:'https://github.com/sinamajidian', contribution:['author', 'maintainer'], orcid:'https://orcid.org/0000-0001-5345-6982'], [name:'Adrian Altenhoff', affiliation:'SIB Swiss Institute of Bioinformatics', github:'https://github.com/alpae', contribution:['author', 'maintainer'], orcid:'https://orcid.org/0000-0001-7492-1273']]
process.cpus = { 1    * task.attempt }
process.memory = { 16.GB * task.attempt }
process.time = { 8.h   * task.attempt }
process.resourceLimits.cpus = 32
process.resourceLimits.memory = '512 GB'
process.resourceLimits.time = '3d'
process.shell = ['/bin/bash', '-euo', 'pipefail']
process.errorStrategy = { task.exitStatus in ((130..145) + 104) ? "retry" : "finish" }
process.maxRetries = 2
process.'withLabel:process_single'.cpus = { 1 }
process.'withLabel:process_single'.memory = { 16.GB  * task.attempt }
process.'withLabel:process_single'.time = { 8.h    * task.attempt }
process.'withLabel:process_medium'.cpus = { 6     * task.attempt }
process.'withLabel:process_medium'.memory = { 36.GB * task.attempt }
process.'withLabel:process_medium'.time = { 12.h  * task.attempt }
process.'withLabel:process_high'.cpus = { 12     * task.attempt }
process.'withLabel:process_high'.memory = { 128.GB * task.attempt }
process.'withLabel:process_high'.time = { 24.h   * task.attempt }
process.'withName:omamer_run'.cpus = { 1 }
process.'withName:omamer_run'.memory = { 2.GB + 2.KB * Math.ceil(omamer_db.size()/1024) * task.attempt }
process.'withName:omamer_run'.time = { 1.h * task.attempt }
process.'withName:infer_roothogs'.memory = {
            def nr_genomes  = hogmaps.size()
            def base_memory = 2.GB + (nr_genomes * 200.MB)
            return base_memory * task.attempt * params.memory_multiplier
        }
process.'withName:infer_roothogs'.time = { 12.h * task.attempt * params.time_multiplier }
process.'withName:collect_subhogs'.cpus = { 1 }
process.'withName:fastoma_report'.cpus = { 1 }
process.'withName:extract_pairwise_ortholog_relations'.cpus = { 1 }
executor.name = 'slurm'
executor.queueSize = 200
