manifest.name = 'dessimozlab/FastOMA'
manifest.description = 'FastOMA computes Hierarchical Orthologous Groups from proteomes.'
manifest.author = 'Sina Majidian, Adrian Altenhoff'
manifest.homePage = 'https://omabrowser.org'
manifest.mainScript = 'FastOMA.nf'
manifest.nextflowVersion = '>=22.10.4'
manifest.defaultBranch = 'main'
manifest.doi = '10.1101/2024.01.29.577392'
