// Prepared 2026-11-05. Use software/fastoma/FastOMA.nf with -profile slurm,large.
// Do not combine with the historical cafa_oma.config,
// whose validator override points to a different FastOMA installation.
// Activate the intended Conda environment before launching Nextflow.

params.min_sequence_length = 10

executor {
    queueSize = 200
}

process {
    executor = 'slurm'
    // The launcher job's account is not a substitute for each task's account.
    clusterOptions = '--account=evomics_projects'

    // CPU/time ceilings retained; memory ceiling set by Sascha on 2026-11-05.
    resourceLimits = [cpus: 32, memory: 256.GB, time: 72.h]

    // projectDir is the directory containing FastOMA.nf, not the launch directory.
    // Load the edited Python source for all FastOMA console commands.
    beforeScript = """
        export PYTHONPATH="${projectDir}:\${PYTHONPATH:-}"
    """

    withName: check_input {
        memory = { 32.GB * task.attempt }
        beforeScript = """
            export PYTHONPATH="${projectDir}:\${PYTHONPATH:-}"
            python -c 'import FastOMA.check_input as c; from pathlib import Path; print("Validator loaded:", c.__file__); assert Path(c.__file__).resolve() == Path("${projectDir}/FastOMA/check_input.py").resolve(), "Wrong validator loaded"'
        """
    }
}

// No partition is forced: confirm site/account limits before a production run.
// The slurm,large profiles retain the existing per-process resource formulas,
// retry strategy and maximum of two retries. queueSize limits submitted tasks,
// not the total CPU or memory allocation across all jobs.
